# ─── Required ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Model Settings ──────────────────────────────────────────────
MODEL_NAME=claude-haiku-4-5
TEMPERATURE=0.1
# Toplam deneme sayısı (ilk deneme dahil, en az 1)
MAX_RETRY=2
# LLM çağrısı başına timeout (sn) ve SDK seviyesinde yeniden deneme sayısı
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=4096

# ─── API Limits ──────────────────────────────────────────────────
MAX_UPLOAD_MB=20
MAX_QUESTION_LENGTH=1000

# ─── Infrastructure ──────────────────────────────────────────────
# Use http://localhost:6333 for local dev
# Docker Compose overrides this to http://qdrant:6333 automatically
QDRANT_URL=http://localhost:6333
